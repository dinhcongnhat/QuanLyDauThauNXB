datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN // Quản trị viên - Super admin, cấp mọi quyền
  USER // Người dùng thường
}

enum DocType {
  TT_DUTOAN
  QD_DUTOAN
  TT_KHLCNT
  BC_KHLCNT
  QD_KHLCNT
  // Contractor selection document types
  LCNT_STEP
}

enum DocStatus {
  DRAFT
  COMPLETED
  PENDING_APPROVAL
  PENDING_HEAD
  PENDING_DIRECTOR
  APPROVED
  REJECTED
}

enum ProcurementMethod {
  CHI_DINH_THAU
  CHAO_HANG_CANH_TRANH
  DAU_THAU_RONG_RAI
}

enum ContractPackageType {
  GOI_THAU_TU_VAN
  GOI_THAU_PHI_TU_VAN
  GOI_THAU_TRIEN_KHAI
}

enum StepApprovalStatus {
  NO_APPROVAL_REQUIRED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ApprovalTargetType {
  DAT_SACH_DECISION
  DOCUMENT
  PROCUREMENT_STEP
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DossierWorkflowType {
  DU_TOAN
  KHLCNT
  DAT_SACH
  LCNT_QD_HSMT
  LCNT_QD_KQLCNT
  LCNT_QD_LCNT
}

enum DossierStatus {
  DRAFT
  IN_REVIEW
  REWORK
  APPROVED
  CANCELLED
}

enum DossierItemKind {
  COVER
  PROPOSAL
  REPORT
  DECISION
  SUPPORTING_DOCUMENT
  ATTACHMENT
  REFERENCE
}

enum DossierItemSource {
  FORM
  FILE
  ENTITY_REFERENCE
}

enum ChatAttachmentKind {
  IMAGE
  VIDEO
  OFFICE
  PDF
  FILE
}

// ====================== DatSach / Thầu Sách ======================

enum ProcurementType {
  THAU_THIET_BI
  THAU_SACH
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GDNStatus {
  DRAFT
  COMPLETED
  PENDING_REVIEW
  APPROVED
  REWORK
}

enum ReviewStatus {
  PENDING
  APPROVED
  REWORK
}

model Project {
  id              String          @id @default(uuid())
  tenDuAn         String          @map("ten_du_an")
  procurementType ProcurementType @map("procurement_type")
  status          ProjectStatus   @default(IN_PROGRESS) @map("project_status")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  creator              User                       @relation("ProjectCreator", fields: [createdBy], references: [id])
  documents            Document[]                 @relation("ProjectDocuments")
  contractorSelections ContractorSelection[]      @relation("ProjectContractorSelections")
  payments             Payment[]                  @relation("ProjectPayments")
  datSachProjects      DatSachProject[]           @relation("ProjectDatSachProjects")
  logs                 ProjectLog[]               @relation("ProjectLogs")
  members              ProjectMember[]            @relation("ProjectMembers")
  messages             ProjectMessage[]           @relation("ProjectMessages")
  messageReads         ProjectMessageRead[]
  messageAttachments   ProjectMessageAttachment[]
  approvalDossiers     ApprovalDossier[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER") // OWNER, MEMBER
  addedBy   String   @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  project     Project @relation("ProjectMembers", fields: [projectId], references: [id], onDelete: Cascade)
  user        User    @relation("UserProjectMembers", fields: [userId], references: [id])
  addedByUser User    @relation("AddedByProjectMembers", fields: [addedBy], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectMessage {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  userId          String   @map("user_id")
  clientMessageId String?  @map("client_message_id")
  content         String
  type            String   @default("TEXT") // TEXT, FILE, IMAGE, VIDEO
  fileUrl         String?  @map("file_url")
  fileName        String?  @map("file_name")
  fileType        String?  @map("file_type")
  fileSize        Int?     @map("file_size")
  module          String? // DAT_SACH, DU_TOAN, KHLCNT, LCNT, THANH_TOAN
  createdAt       DateTime @default(now()) @map("created_at")

  project     Project                    @relation("ProjectMessages", fields: [projectId], references: [id], onDelete: Cascade)
  user        User                       @relation("UserProjectMessages", fields: [userId], references: [id])
  mentions    ProjectMessageMention[]
  attachments ProjectMessageAttachment[]
  reactions   ProjectMessageReaction[]

  @@unique([userId, clientMessageId])
  @@index([projectId, createdAt])
  @@index([projectId, module])
  @@map("project_messages")
}

model ProjectMessageRead {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  userId     String   @map("user_id")
  moduleKey  String   @default("GENERAL") @map("module_key")
  lastReadAt DateTime @default(now()) @map("last_read_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, moduleKey])
  @@index([userId, lastReadAt])
  @@map("project_message_reads")
}

model ProjectMessageMention {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  userId    String @map("user_id")
  start     Int
  length    Int
  label     String

  message ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, start])
  @@index([userId])
  @@map("project_message_mentions")
}

model ProjectMessageAttachment {
  id           String             @id @default(uuid())
  messageId    String?            @map("message_id")
  projectId    String             @map("project_id")
  uploaderId   String             @map("uploader_id")
  objectPath   String             @unique @map("object_path")
  originalName String             @map("original_name")
  mimeType     String             @map("mime_type")
  size         Int
  kind         ChatAttachmentKind
  createdAt    DateTime           @default(now()) @map("created_at")

  message  ProjectMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([uploaderId, messageId])
  @@map("project_message_attachments")
}

model ProjectMessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  message ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("project_message_reactions")
}

model DatSachProject {
  id              String          @id @default(uuid())
  projectId       String?         @map("project_id")
  parentId        String          @map("parent_id")
  procurementType ProcurementType @default(THAU_SACH) @map("procurement_type")
  tenDuAn         String          @map("ten_du_an")
  status          ProjectStatus   @default(IN_PROGRESS) @map("status")
  qdData          Json            @default("{}") @map("qd_data")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Review workflow
  reviewerId    String?       @map("reviewer_id")
  reviewStatus  ReviewStatus? @map("review_status")
  reviewComment String?       @map("review_comment")
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewHistory Json          @default("[]") @map("review_history")

  project          Project?          @relation("ProjectDatSachProjects", fields: [projectId], references: [id])
  creator          User              @relation("DatSachProjectCreator", fields: [createdBy], references: [id])
  reviewer         User?             @relation("DatSachProjectReviewer", fields: [reviewerId], references: [id])
  gdnDocuments     GDNInSach[]       @relation("DatSachProjectGdn")
  pcdiDocuments    PCDICoSoIn[]      @relation("DatSachProjectPcdi")
  approvalRequests ApprovalRequest[]

  @@index([projectId])
  @@index([parentId])
  @@index([createdBy])
  @@map("dat_sach_projects")
}

model GDNInSach {
  id               String    @id @default(uuid())
  datSachProjectId String    @map("dat_sach_project_id")
  status           GDNStatus @default(DRAFT)
  data             Json      @default("{}")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Review workflow
  reviewerId    String?       @map("reviewer_id")
  reviewStatus  ReviewStatus? @map("review_status")
  reviewComment String?       @map("review_comment")
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewHistory Json          @default("[]") @map("review_history")
  docxPath      String?       @map("docx_path")

  datSachProject DatSachProject  @relation("DatSachProjectGdn", fields: [datSachProjectId], references: [id])
  creator        User            @relation("GDNInSachCreator", fields: [createdBy], references: [id])
  reviewer       User?           @relation("GDNInSachReviewer", fields: [reviewerId], references: [id])
  assignments    GDNAssignment[] @relation("GDNInSachAssignments")

  @@map("gdn_in_sach")
}

model GDNAssignment {
  id          String    @id @default(uuid())
  gdnInSachId String    @map("gdn_in_sach_id")
  userId      String    @map("user_id")
  assignedBy  String    @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  soLuong     Int       @default(0) @map("so_luong")
  completedAt DateTime? @map("completed_at")

  gdnInSach GDNInSach @relation("GDNInSachAssignments", fields: [gdnInSachId], references: [id])
  user      User      @relation("GDNAssignmentUser", fields: [userId], references: [id])
  assignee  User      @relation("AssignmentAssignee", fields: [assignedBy], references: [id])

  @@unique([gdnInSachId, userId])
  @@map("gdn_assignments")
}

model PCDICoSoIn {
  id               String    @id @default(uuid())
  datSachProjectId String    @map("dat_sach_project_id")
  status           GDNStatus @default(DRAFT)
  data             Json      @default("{}")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Review workflow
  reviewerId    String?       @map("reviewer_id")
  reviewStatus  ReviewStatus? @map("review_status")
  reviewComment String?       @map("review_comment")
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewHistory Json          @default("[]") @map("review_history")
  docxPath      String?       @map("docx_path")

  datSachProject DatSachProject @relation("DatSachProjectPcdi", fields: [datSachProjectId], references: [id])
  creator        User           @relation("PCDICoSoInCreator", fields: [createdBy], references: [id])
  reviewer       User?          @relation("PCDIReviewer", fields: [reviewerId], references: [id])

  @@map("pcdi_co_so_in")
}

// StepApprovalRequest must be declared before User since User references it
model StepApprovalRequest {
  id        String   @id @default(uuid())
  stepId    String   @map("step_id")
  userId    String   @map("user_id")
  action    String // PENDING_APPROVAL, APPROVED, REJECTED
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  step ProcurementStep @relation(fields: [stepId], references: [id])
  user User            @relation(fields: [userId], references: [id])

  @@map("step_approval_requests")
}

enum NotificationType {
  DOC_APPROVED
  DOC_REJECTED
  DOC_SUBMITTED
  GDN_APPROVED
  PCDI_APPROVED
  QD_APPROVED
  STEP_APPROVED
  STEP_REJECTED
  STEP_PENDING_APPROVAL
  STEP_COMPLETED
  PAYMENT_CREATED
  PAYMENT_COMPLETED
  BID_RESULT
  ASSIGNMENT
  PROJECT_COMPLETED
  APPROVAL_SUBMITTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  CHAT_MENTION
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ====================== Dynamic RBAC ======================

model DynamicRole {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  priority    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions DynamicRolePermission[]
  userRoles   UserDynamicRole[]

  @@map("dynamic_roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  displayName String   @map("display_name")
  description String?
  category    String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions DynamicRolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model DynamicRolePermission {
  id        String   @id @default(uuid())
  roleId    String   @map("role_id")
  permId    String   @map("permission_id")
  createdAt DateTime @default(now()) @map("created_at")

  role       DynamicRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission  @relation(fields: [permId], references: [id], onDelete: Cascade)

  @@unique([roleId, permId])
  @@map("dynamic_role_permissions")
}

model UserDynamicRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User        @relation("UserDynamicRoles", fields: [userId], references: [id], onDelete: Cascade)
  role DynamicRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_dynamic_roles")
}

model UserPermission {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  permId    String   @map("permission_id")
  createdAt DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permId], references: [id], onDelete: Cascade)

  @@unique([userId, permId])
  @@index([permId])
  @@map("user_permissions")
}

// ====================== User ======================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(USER)
  canApprove   Boolean  @default(false) @map("can_approve") // User có quyền phê duyệt (do Super Admin cấp)
  isInvestor   Boolean  @default(false) @map("is_investor")
  isContractor Boolean  @default(false) @map("is_contractor")
  department   String?
  position     String?  @map("position") // Chức vụ (VD: "Kế toán trưởng", "Trưởng phòng kinh doanh")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdDocs                Document[]                 @relation("DocCreator")
  delegatedDocs              Document[]                 @relation("DocDelegatee")
  assignedDocs               Document[]                 @relation("DocAssignee")
  reviews                    Review[]
  contractorSelections       ContractorSelection[]      @relation("ContractorSelectionCreator")
  stepApprovalRequests       StepApprovalRequest[]
  payments                   Payment[]                  @relation("PaymentCreator")
  bidParticipations          BidParticipation[]         @relation("BidParticipationCreator")
  gdnDocuments               GDNInSach[]                @relation("GDNInSachCreator")
  gdnAssignments             GDNAssignment[]            @relation("GDNAssignmentUser")
  gdnAssignmentsGiven        GDNAssignment[]            @relation("AssignmentAssignee")
  gdnReviewer                GDNInSach[]                @relation("GDNInSachReviewer")
  pcdiDocuments              PCDICoSoIn[]               @relation("PCDICoSoInCreator")
  pcdiReviewer               PCDICoSoIn[]               @relation("PCDIReviewer")
  datSachProjects            DatSachProject[]           @relation("DatSachProjectCreator")
  datSachReviewer            DatSachProject[]           @relation("DatSachProjectReviewer")
  createdProjects            Project[]                  @relation("ProjectCreator")
  notifications              Notification[]
  pushSubscriptions          PushSubscription[]
  dynamicRoles               UserDynamicRole[]          @relation("UserDynamicRoles")
  projectLogs                ProjectLog[]               @relation("UserProjectLogs")
  projectMemberships         ProjectMember[]            @relation("UserProjectMembers")
  addedProjectMembers        ProjectMember[]            @relation("AddedByProjectMembers")
  projectMessages            ProjectMessage[]           @relation("UserProjectMessages")
  projectMessageReads        ProjectMessageRead[]
  projectMessageMentions     ProjectMessageMention[]
  projectMessageReactions    ProjectMessageReaction[]
  uploadedMessageAttachments ProjectMessageAttachment[]
  approvalRequestsSent       ApprovalRequest[]          @relation("ApprovalRequester")
  approvalRequestsReceived   ApprovalRequest[]          @relation("ApprovalApprover")
  directPermissions          UserPermission[]
  approvalDossiersCreated    ApprovalDossier[]          @relation("DossierCreator")
  approvalDossiersHandled    ApprovalDossier[]          @relation("DossierCurrentHandler")
  approvalDossierRevisions   ApprovalDossierRevision[]

  @@map("users")
}

model RolePermission {
  id            String   @id @default(uuid())
  role          Role
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([role, permissionKey])
  @@map("roles_permissions")
}

model Document {
  id               String           @id @default(uuid())
  projectId        String?          @map("project_id")
  procurementType  ProcurementType? @map("procurement_type")
  type             DocType
  status           DocStatus        @default(DRAFT)
  data             Json             @default("{}")
  parentId         String?          @map("parent_id")
  sourceDocumentId String?          @map("source_document_id")
  createdBy        String           @map("created_by")
  delegatedTo      String?          @map("delegated_to")
  assignedTo       String?          @map("assigned_to")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  project              Project?              @relation("ProjectDocuments", fields: [projectId], references: [id])
  creator              User                  @relation("DocCreator", fields: [createdBy], references: [id])
  delegatee            User?                 @relation("DocDelegatee", fields: [delegatedTo], references: [id])
  assignee             User?                 @relation("DocAssignee", fields: [assignedTo], references: [id])
  parent               Document?             @relation("DocParent", fields: [parentId], references: [id])
  children             Document[]            @relation("DocParent")
  sourceDocument       Document?             @relation("DocumentSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  derivedDocuments     Document[]            @relation("DocumentSource")
  reviews              Review[]
  contractorSelections ContractorSelection[] @relation("ContractorSelectionDoc")
  approvalRequests     ApprovalRequest[]

  @@index([projectId])
  @@index([sourceDocumentId])
  @@index([createdBy])
  @@index([type, status])
  @@index([assignedTo])
  @@map("documents")
}

model Review {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  userId     String   @map("user_id")
  action     String
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
  @@map("reviews")
}

model ApprovalRequest {
  id                String                @id @default(uuid())
  targetType        ApprovalTargetType    @map("target_type")
  status            ApprovalRequestStatus @default(PENDING)
  documentId        String?               @map("document_id")
  datSachProjectId  String?               @map("dat_sach_project_id")
  procurementStepId String?               @map("procurement_step_id")
  requesterId       String                @map("requester_id")
  approverId        String                @map("approver_id")
  submitComment     String?               @map("submit_comment")
  decisionComment   String?               @map("decision_comment")
  submittedAt       DateTime              @default(now()) @map("submitted_at")
  decidedAt         DateTime?             @map("decided_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  dossierId         String?               @map("dossier_id")
  previousRequestId String?               @map("previous_request_id")
  hopIndex          Int                   @default(1) @map("hop_index")

  document        Document?         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  datSachProject  DatSachProject?   @relation(fields: [datSachProjectId], references: [id], onDelete: Cascade)
  procurementStep ProcurementStep?  @relation(fields: [procurementStepId], references: [id], onDelete: Cascade)
  requester       User              @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approver        User              @relation("ApprovalApprover", fields: [approverId], references: [id])
  dossier         ApprovalDossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  previousRequest ApprovalRequest?  @relation("ApprovalRequestChain", fields: [previousRequestId], references: [id], onDelete: SetNull)
  nextRequests    ApprovalRequest[] @relation("ApprovalRequestChain")

  @@index([approverId, status, submittedAt])
  @@index([requesterId, submittedAt])
  @@index([targetType, status])
  @@index([documentId])
  @@index([datSachProjectId])
  @@index([procurementStepId])
  @@index([dossierId, status, submittedAt])
  @@index([previousRequestId])
  @@map("approval_requests")
}

model ApprovalDossier {
  id               String              @id @default(uuid())
  workflowType     DossierWorkflowType @map("workflow_type")
  status           DossierStatus       @default(DRAFT)
  version          Int                 @default(1)
  projectId        String?             @map("project_id")
  targetType       ApprovalTargetType? @map("target_type")
  targetId         String?             @map("target_id")
  context          Json                @default("{}")
  createdBy        String              @map("created_by")
  currentHandlerId String?             @map("current_handler_id")
  title            String
  approvedAt       DateTime?           @map("approved_at")
  cancelledAt      DateTime?           @map("cancelled_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  project        Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        User                      @relation("DossierCreator", fields: [createdBy], references: [id])
  currentHandler User?                     @relation("DossierCurrentHandler", fields: [currentHandlerId], references: [id])
  items          ApprovalDossierItem[]
  revisions      ApprovalDossierRevision[]
  requests       ApprovalRequest[]

  @@index([projectId, workflowType, status])
  @@index([createdBy, status, updatedAt])
  @@index([currentHandlerId, status, updatedAt])
  @@index([targetType, targetId])
  @@map("approval_dossiers")
}

model ApprovalDossierItem {
  id                   String            @id @default(uuid())
  dossierId            String            @map("dossier_id")
  itemKey              String            @map("item_key")
  label                String
  kind                 DossierItemKind
  source               DossierItemSource
  entityType           String?           @map("entity_type")
  entityId             String?           @map("entity_id")
  data                 Json              @default("{}")
  objectPath           String?           @map("object_path")
  renderedOverridePath String?           @map("rendered_override_path")
  originalName         String?           @map("original_name")
  mimeType             String?           @map("mime_type")
  sortOrder            Int               @default(0) @map("sort_order")
  required             Boolean           @default(true)
  editable             Boolean           @default(true)
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  dossier   ApprovalDossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  revisions ApprovalDossierRevision[]

  @@unique([dossierId, itemKey])
  @@index([entityType, entityId])
  @@map("approval_dossier_items")
}

model ApprovalDossierRevision {
  id          String   @id @default(uuid())
  dossierId   String   @map("dossier_id")
  itemId      String?  @map("item_id")
  actorId     String   @map("actor_id")
  action      String
  fromVersion Int      @map("from_version")
  toVersion   Int      @map("to_version")
  comment     String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  dossier ApprovalDossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  item    ApprovalDossierItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  actor   User                 @relation(fields: [actorId], references: [id])

  @@index([dossierId, createdAt])
  @@index([itemId, createdAt])
  @@map("approval_dossier_revisions")
}

model ContractorSelection {
  id                String            @id @default(uuid())
  projectId         String?           @map("project_id")
  qdKhlcntId        String            @map("qd_khlcnt_id")
  goiThauIndex      Int               @map("goi_thau_index")
  packageId         String?           @map("package_id")
  tenGoiThau        String            @map("ten_goi_thau")
  procurementMethod ProcurementMethod @map("procurement_method")
  data              Json              @default("{}")
  createdBy         String            @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  contractPackageType ContractPackageType? @map("contract_package_type")
  soHopDong           String?              @map("so_hop_dong")
  ngayKyHopDong       DateTime?            @map("ngay_ky_hop_dong")

  project  Project?          @relation("ProjectContractorSelections", fields: [projectId], references: [id])
  qdKhlcnt Document          @relation("ContractorSelectionDoc", fields: [qdKhlcntId], references: [id])
  creator  User              @relation("ContractorSelectionCreator", fields: [createdBy], references: [id])
  steps    ProcurementStep[]
  payments Payment[]

  @@unique([qdKhlcntId, goiThauIndex])
  @@index([projectId])
  @@index([qdKhlcntId])
  @@index([packageId])
  @@index([soHopDong])
  @@map("contractor_selections")
}

model ProcurementStep {
  id                    String    @id @default(uuid())
  contractorSelectionId String    @map("contractor_selection_id")
  stepKey               String    @map("step_key")
  stepOrder             Int       @map("step_order")
  title                 String
  status                String    @default("NOT_STARTED")
  data                  Json      @default("{}")
  attachmentPath        String?   @map("attachment_path")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Approval fields
  requiresApproval Boolean            @default(false) @map("requires_approval")
  approvalStatus   StepApprovalStatus @default(NO_APPROVAL_REQUIRED) @map("approval_status")
  approvedBy       String?            @map("approved_by")
  approvedAt       DateTime?          @map("approved_at")
  approverRole     String?            @map("approver_role")
  approvalComment  String?            @map("approval_comment")

  contractorSelection ContractorSelection   @relation(fields: [contractorSelectionId], references: [id])
  approvalRequests    StepApprovalRequest[]
  approvalWorkflows   ApprovalRequest[]

  @@unique([contractorSelectionId, stepKey])
  @@index([contractorSelectionId, stepKey])
  @@index([approvalStatus])
  @@map("procurement_steps")
}

model Payment {
  id                    String              @id @default(uuid())
  projectId             String?             @map("project_id")
  contractorSelectionId String              @map("contractor_selection_id")
  contractPackageType   ContractPackageType @map("contract_package_type")
  maSoHD                String?             @map("ma_so_hd")
  data                  Json                @default("{}")
  createdBy             String              @map("created_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  project             Project?            @relation("ProjectPayments", fields: [projectId], references: [id])
  contractorSelection ContractorSelection @relation(fields: [contractorSelectionId], references: [id])
  creator             User                @relation("PaymentCreator", fields: [createdBy], references: [id])
  steps               PaymentStep[]

  @@index([projectId])
  @@index([contractorSelectionId])
  @@map("payments")
}

model PaymentStep {
  id             String    @id @default(uuid())
  paymentId      String    @map("payment_id")
  stepKey        String    @map("step_key")
  stepOrder      Int       @map("step_order")
  title          String
  status         String    @default("NOT_STARTED")
  data           Json      @default("{}")
  attachmentPath String?   @map("attachment_path")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, stepKey])
  @@index([paymentId, stepKey])
  @@map("payment_steps")
}

// ====================== Nhà thầu - Tham dự đấu thầu ======================

enum BidResult {
  PENDING
  WON
  LOST
}

model BidParticipation {
  id                String    @id @default(uuid())
  maThongBaoMoiThau String    @map("ma_thong_bao_moi_thau")
  tenChuDauTu       String    @map("ten_chu_dau_tu")
  tenGoiThau        String?   @map("ten_goi_thau")
  result            BidResult @default(PENDING)
  data              Json      @default("{}")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  creator User      @relation("BidParticipationCreator", fields: [createdBy], references: [id])
  steps   BidStep[]

  @@map("bid_participations")
}

model BidStep {
  id                 String    @id @default(uuid())
  bidParticipationId String    @map("bid_participation_id")
  stepKey            String    @map("step_key")
  stepOrder          Int       @map("step_order")
  title              String
  status             String    @default("NOT_STARTED")
  data               Json      @default("{}")
  attachments        Json      @default("[]")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  bidParticipation BidParticipation @relation(fields: [bidParticipationId], references: [id])

  @@unique([bidParticipationId, stepKey])
  @@map("bid_steps")
}

model ProjectLog {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  stepKey   String   @map("step_key")
  action    String
  message   String
  data      Json?    @map("data")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation("ProjectLogs", fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("UserProjectLogs", fields: [userId], references: [id])

  @@index([projectId, stepKey])
  @@index([createdAt])
  @@map("project_logs")
}

// ====================== Legal Document Library ======================

model LegalDocument {
  id              String   @id @default(uuid())
  tenCanCu        String?  @map("ten_can_cu")
  soHieu          String   @map("so_hieu")
  coQuanBanHanh   String   @map("co_quan_ban_hanh")
  hinhThucVanBan  String   @map("hinh_thuc_van_ban")
  linhVuc         String   @map("linh_vuc")
  trichYeuNoiDung String   @map("trich_yeu_noi_dung")
  ngayBanHanh     DateTime @map("ngay_ban_hanh") @db.Date
  originalObjectPath String? @map("original_object_path")
  originalName       String? @map("original_name")
  originalMimeType   String? @map("original_mime_type")
  originalSize       Int?    @map("original_size")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenCanCu])
  @@index([soHieu])
  @@index([coQuanBanHanh])
  @@index([hinhThucVanBan])
  @@index([linhVuc])
  @@index([ngayBanHanh])
  @@map("legal_documents")
}
